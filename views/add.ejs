<%- include('partials/header') %>

<h2>Добавить активность</h2>

<% if (error) { %>
    <p class="error"><%= error %></p>
<% } %>

<form action="/add?auth=1" method="POST" class="form">
    <label>Дата
        <input type="date" name="date" required>
    </label>
    <label>Шаги
        <input type="number" name="steps" min="0" required>
    </label>
    <label>Калории
        <input type="number" name="calories" min="0" step="0.1" required>
    </label>
    <button type="submit">Добавить</button>
</form>

<p><a href="/">← Назад к списку</a></p>

<%- include('partials/footer') %>
