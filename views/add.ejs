<%- include('partials/header') %>

<h2>Добавить активность</h2>

<form action="/add?auth=1" method="POST" class="form" novalidate>
    <div class="field <%= errors && errors.date ? 'field-error' : '' %>">
        <label for="date">Дата</label>
        <input type="date" name="date" id="date" value="<%= values ? values.date : '' %>">
        <% if (errors && errors.date) { %>
            <span class="field-msg"><%= errors.date %></span>
        <% } %>
    </div>
    <div class="field <%= errors && errors.steps ? 'field-error' : '' %>">
        <label for="steps">Шаги</label>
        <input type="number" name="steps" id="steps" value="<%= values ? values.steps : '' %>">
        <% if (errors && errors.steps) { %>
            <span class="field-msg"><%= errors.steps %></span>
        <% } %>
    </div>
    <div class="field <%= errors && errors.calories ? 'field-error' : '' %>">
        <label for="calories">Калории</label>
        <input type="number" name="calories" id="calories" step="0.1" value="<%= values ? values.calories : '' %>">
        <% if (errors && errors.calories) { %>
            <span class="field-msg"><%= errors.calories %></span>
        <% } %>
    </div>
    <button type="submit">Добавить</button>
</form>

<p><a href="/?auth=1">← Назад к списку</a></p>

<%- include('partials/footer') %>
