<%- include('partials/header') %>

<h2>Добавить активность</h2>

<form action="/add?auth=1" method="POST" class="form" novalidate>
    <div class="field <%= errors && errors.date ? 'field-error' : '' %>">
        <label for="date">Дата</label>
        <input type="date" name="date" id="date" min="2000-01-01"
               value="<%= values ? values.date : '' %>">
        <% if (errors && errors.date) { %>
            <span class="field-msg"><%= errors.date %></span>
        <% } %>
    </div>
    <div class="field <%= errors && errors.steps ? 'field-error' : '' %>">
        <label for="steps">Шаги</label>
        <input type="text" inputmode="numeric" pattern="\d*" maxlength="6"
               name="steps" id="steps" autocomplete="off"
               value="<%= values ? values.steps : '' %>">
        <% if (errors && errors.steps) { %>
            <span class="field-msg"><%= errors.steps %></span>
        <% } %>
    </div>
    <div class="field <%= errors && errors.calories ? 'field-error' : '' %>">
        <label for="calories">Калории, кКал</label>
        <input type="text" inputmode="decimal" pattern="\d*([.,]\d+)?" maxlength="6"
               name="calories" id="calories" autocomplete="off"
               value="<%= values ? values.calories : '' %>">
        <% if (errors && errors.calories) { %>
            <span class="field-msg"><%= errors.calories %></span>
        <% } %>
    </div>
    <button type="submit">Добавить</button>
</form>

<p><a href="/?auth=1">← Назад к списку</a></p>

<script>

    function sanitize(el, allowDot) {
        var re = allowDot ? /[^0-9.]/g : /[^0-9]/g;
        var clean = el.value.replace(re, '');
        if (allowDot) {
            // оставляем только одну точку
            var parts = clean.split('.');
            clean = parts.shift() + (parts.length ? '.' + parts.join('') : '');
        }
        if (clean !== el.value) el.value = clean;
    }
    var steps = document.getElementById('steps');
    var calories = document.getElementById('calories');
    steps.addEventListener('input', function () { sanitize(steps, false); });
    calories.addEventListener('input', function () { sanitize(calories, true); });

    // Ограничиваем поле даты: не позже сегодняшнего дня
    var dateEl = document.getElementById('date');
    if (dateEl) dateEl.max = new Date().toISOString().slice(0, 10);
</script>

<%- include('partials/footer') %>
