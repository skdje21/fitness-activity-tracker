<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> — Fitness Activity Tracker</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site-header">
    <h1>Fitness Activity Tracker</h1>
    <nav>
        <% if (user.role === 'user') { %>
            <a href="/?auth=1">Главная</a>
            <a href="/add?auth=1">Добавить запись</a>
        <% } else { %>
            <a href="/">Главная</a>
        <% } %>
    </nav>
    <div class="user-block">
        <% if (user.role === 'user') { %>
            <span class="user-name"><%= user.name %></span>
            <a href="/" class="btn-auth btn-logout">Выйти</a>
        <% } else { %>
            <span class="user-name">Гость</span>
            <a href="/?auth=1" class="btn-auth btn-login">Войти</a>
        <% } %>
    </div>
</header>
